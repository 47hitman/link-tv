<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title_scan"
            android:textColor="@color/text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:lineSpacingMultiplier="1.2"
            android:padding="12dp"
            android:text="@string/scan_intro"
            android:textColor="@color/text"
            android:textSize="13sp" />

        <TextView
            style="@style/Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/scan_address" />

        <Spinner
            android:id="@+id/address_spinner"
            android:layout_width="match_parent"
            android:layout_height="46dp" />

        <EditText
            android:id="@+id/address_custom"
            style="@style/Field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:digits="0123456789abcdefABCDEFx"
            android:hint="@string/scan_address_custom"
            android:importantForAutofill="no"
            android:inputType="textNoSuggestions"
            android:maxLength="6"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:orientation="vertical">

                <TextView
                    style="@style/Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/scan_target" />

                <Spinner
                    android:id="@+id/target_spinner"
                    android:layout_width="match_parent"
                    android:layout_height="46dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/scan_start_cmd" />

                <EditText
                    android:id="@+id/start_cmd"
                    style="@style/Field"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:digits="0123456789abcdefABCDEF"
                    android:importantForAutofill="no"
                    android:inputType="textNoSuggestions"
                    android:maxLength="2"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:text="00" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/interval_label"
            style="@style/Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <SeekBar
            android:id="@+id/interval_seek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="90" />

        <Button
            android:id="@+id/start_stop"
            style="@style/ActionButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:text="@string/scan_start" />

        <Button
            android:id="@+id/hit"
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/btn_hit"
            android:enabled="false"
            android:stateListAnimator="@null"
            android:text="@string/scan_hit"
            android:textColor="@color/text"
            android:textSize="24sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:max="256" />

        <TextView
            android:id="@+id/progress_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:text="@string/scan_idle"
            android:textColor="@color/text"
            android:textSize="13sp" />

        <TextView
            style="@style/Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/scan_candidates" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/scan_candidates_hint"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/candidates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
