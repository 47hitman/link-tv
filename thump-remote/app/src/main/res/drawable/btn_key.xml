<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/key_pressed" />
            <stroke android:width="1dp" android:color="@color/accent" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#10161F" />
            <stroke android:width="1dp" android:color="#1A2232" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient
                android:angle="270"
                android:startColor="#222D44"
                android:endColor="@color/key" />
            <stroke android:width="1dp" android:color="@color/key_stroke" />
        </shape>
    </item>
</selector>
