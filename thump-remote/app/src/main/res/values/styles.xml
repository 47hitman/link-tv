<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/surface</item>
        <item name="android:colorPrimaryDark">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_muted</item>
        <item name="android:alertDialogTheme">@style/AppDialog</item>
        <item name="android:spinnerStyle">@style/AppSpinner</item>
        <item name="android:spinnerDropDownItemStyle">@style/AppSpinnerItem</item>
    </style>

    <style name="AppDialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorBackground">@color/surface</item>
        <item name="android:textColorPrimary">@color/text</item>
    </style>

    <style name="AppSpinner" parent="android:Widget.Material.Spinner">
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:popupBackground">@color/surface</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>

    <style name="AppSpinnerItem" parent="android:Widget.Material.DropDownItem.Spinner">
        <item name="android:textColor">@color/text</item>
    </style>

    <style name="Label">
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:layout_marginBottom">6dp</item>
    </style>

    <style name="Field">
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="android:padding">12dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">monospace</item>
    </style>

    <style name="ActionButton">
        <item name="android:background">@drawable/btn_accent</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minHeight">46dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <style name="SecondaryButton" parent="ActionButton">
        <item name="android:background">@drawable/btn_key</item>
    </style>
</resources>
